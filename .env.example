# Copy this file to `.env` and fill in the values before `docker compose up`.
# See README.markdown for where each GitHub value comes from. The app fails
# closed at startup unless either DEMO_MODE=1 or the GitHub block below is
# configured.

# Host port the app is published on (default 3000).
APP_PORT=3000

# Database passwords. POSTGRES_PASSWORD belongs to the admin user that runs
# the migrations; the app itself connects as the least-privilege
# `rostfacto_app` role with POSTGRES_APP_PASSWORD.
POSTGRES_PASSWORD=change-me
POSTGRES_APP_PASSWORD=change-me-too

# Public base URL of the app; used to build the OAuth callback URL. Must be
# reachable from the browser and match the GitHub OAuth app settings.
PUBLIC_URL=https://rostfacto.example.com

# GitHub authentication (see README.markdown for where to get these).
GITHUB_ADMIN_ORG=your-org
GITHUB_ADMIN_TEAM_SLUG=your-admin-team
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: colon-separated list of orgs whose teams can be assigned to retros.
GITHUB_USER_ORG=
# Optional: contact shown when an org's teams cannot be listed (SAML SSO).
GITHUB_APP_OWNER=

# Unsecured demo mode: set to 1 to run without authentication (every visitor
# is treated as an admin and a red banner warns that the instance is
# unsecured). When using demo mode, leave the GitHub variables above blank;
# a non-blank GITHUB_ADMIN_ORG always takes precedence over DEMO_MODE.
# PUBLIC_URL is then also optional (defaults to http://localhost:3000).
# Never set DEMO_MODE in production.
DEMO_MODE=
