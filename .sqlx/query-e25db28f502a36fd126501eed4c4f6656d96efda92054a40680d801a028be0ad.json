  "query": "SELECT name as \"name!\", avatar_url, initials as \"initials!\", guest as \"guest!\"\n           FROM (\n               SELECT DISTINCT ON (participant_key)\n                      participant_key, name, avatar_url, initials, guest, joined_at\n               FROM presence\n               WHERE retro_id = $1\n                 AND last_seen_at > NOW() - make_interval(secs => $2::float8)\n               ORDER BY participant_key, joined_at\n           ) AS p\n           ORDER BY joined_at, participant_key",
