{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            u.id as user_id,\n            u.github_id,\n            u.username,\n            u.full_name,\n            s.is_admin,\n            s.teams as \"teams: _\",\n            s.team_listing_errors as \"team_listing_errors: _\"\n        FROM users u\n        JOIN sessions s ON s.user_id = u.id\n        WHERE s.id = $1 AND s.expires_at > NOW()\n        ",
