  "query": "\n        SELECT u.id, u.github_id, u.username, u.full_name, u.access_token\n        FROM users u\n        JOIN sessions s ON s.user_id = u.id\n        WHERE s.id = $1 AND s.expires_at > NOW()\n        ",
