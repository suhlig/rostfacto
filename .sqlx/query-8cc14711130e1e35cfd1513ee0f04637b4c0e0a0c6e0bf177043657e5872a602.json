  "query": "SELECT id as \"id!\", retro_id as \"retro_id!\", text as \"text!\",\n                  category as \"category: _\", created_at as \"created_at!\", status as \"status: _\"\n           FROM items\n           WHERE retro_id = $1\n           AND category = 'BAD'\n           AND status != 'ARCHIVED'::status\n           ORDER BY created_at ASC",
